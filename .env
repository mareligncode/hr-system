# ─────────────────────────────────────────────────────────────────────────────
# Root .env — read by docker-compose.
# Never commit this file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
FRONTEND_PORT=5174
DB_PORT_HOST=5433

DB_USER=hr_user
DB_PASSWORD=hr_password
DB_NAME=hr_database

# Generate a real secret before production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_use_64_char_random_hex
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

