FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including devDependencies)
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 5174

# Start Vite dev server with host binding for Docker
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5174"]